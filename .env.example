# Server-side only. Used by api/explain.ts; never sent to the browser.
# Free NVIDIA API key (starts with nvapi-) from https://build.nvidia.com: open a Nemotron model page, click "Get API Key".
NVIDIA_API_KEY=
# Optional: pin a model. Unset = try nvidia/nemotron-3-super-120b-a12b, then 3.5-lightning, nano-3, llama-3.1-nemotron-70b,
# skipping any your key can't use (HTTP 404).
NVIDIA_MODEL=
