# Server-side only. Used by api/explain.ts; never sent to the browser.
# Free NVIDIA API key (starts with nvapi-) from https://build.nvidia.com: open a Nemotron model page, click "Get API Key".
NVIDIA_API_KEY=
# Optional: override the model, e.g. nvidia/nemotron-3.5-lightning-30b-a3b (faster). Default: nvidia/nemotron-3-super-120b-a12b
NVIDIA_MODEL=
